    <string name="home_no_root_title">Root não disponível</string>
    <string name="home_no_root_desc">Este aplicativo requer acesso root e não fará nenhuma alteração sem ele.\nInstale KernelSU, Magisk ou APatch e conceda root.</string>
    <string name="home_unsupported_title">Dispositivo não suportado</string>
    <string name="home_unsupported_desc">O aparelho possui root, mas sua configuração não corresponde a um perfil suportado. Nenhuma modificação foi feita.\n</string>
    <string name="home_volatile_root_notice">Apenas o Soft Reboot (userspace) é utilizado pelo app. Um reboot completo zera mounts dinâmicos e perde o root temporário do exploit.</string>
